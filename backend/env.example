# Copy to .env and fill in real values. Never commit real secrets.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-real-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres — see backend/README.md for how local Postgres is provisioned
# (a dedicated dev-only cluster, not the machine's system Postgres service).
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Initial admin bootstrap — read by `manage.py createinitialadmin`
INITIAL_ADMIN_EMAIL=admin@hrms.local
INITIAL_ADMIN_PASSWORD=change-me-in-every-real-environment

# JWT / auth (Phase 1, not yet wired)
JWT_SIGNING_KEY=change-me-in-every-real-environment

# S3 document storage (env-driven). Set AWS_STORAGE_BUCKET_NAME to store
# document uploads in S3; leave it UNSET and files stay on the local
# hrms_media volume (/app/media) — dev without creds keeps working.
# The bucket is treated as PRIVATE: view/download endpoints stream bytes
# through the backend (boto3), never a public URL, and uploads set no ACL.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional — only for S3-compatible backends (MinIO, LocalStack). Leave
# unset for real AWS. Keys may also be omitted entirely when the runtime
# provides credentials (EC2/ECS IAM role); boto3's default chain applies.
AWS_S3_ENDPOINT_URL=

# SMTP (Phase 2+, not yet wired)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# LMS integration (docs/LMS-INTEGRATION.md)
LMS_INTEGRATION_ENABLED=false
LMS_BASE_URL=
LMS_OUTBOUND_SECRET=
LMS_INBOUND_SECRET=
LMS_SSO_SECRET=
LMS_SSO_LAUNCH_URL=
