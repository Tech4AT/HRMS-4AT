# Copy to .env and fill in real values. Never commit real secrets.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-real-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres — see backend/README.md for how local Postgres is provisioned
# (a dedicated dev-only cluster, not the machine's system Postgres service).
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Initial admin bootstrap — read by `manage.py createinitialadmin`
INITIAL_ADMIN_EMAIL=admin@hrms.local
INITIAL_ADMIN_PASSWORD=change-me-in-every-real-environment

# JWT / auth (Phase 1, not yet wired)
JWT_SIGNING_KEY=change-me-in-every-real-environment

# S3 (Phase 2+, not yet wired)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# SMTP (Phase 2+, not yet wired)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# LMS integration (docs/LMS-INTEGRATION.md)
LMS_INTEGRATION_ENABLED=false
LMS_BASE_URL=
LMS_OUTBOUND_SECRET=
LMS_INBOUND_SECRET=
LMS_SSO_SECRET=
LMS_SSO_LAUNCH_URL=
