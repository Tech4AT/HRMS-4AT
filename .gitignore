# Local dev environment (Docker) — kept locally for the maintainer's dev stack,
# not shared. Peers run each module natively (manage.py / next dev), so these
# are intentionally untracked. CI runs pytest directly and does not use Docker.
/.dockerignore
/Dockerfile
/docker-compose.yml
/docker-entrypoint.sh
/backend/.dockerignore
/backend/Dockerfile
/backend/docker-compose.yml
/backend/docker-entrypoint.sh
/frontend/.dockerignore
